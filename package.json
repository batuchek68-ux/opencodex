git checkout -b fix/package-json
# 将上面合法的 JSON 写入 package.json（比如使用编辑器或重定向写入）
# 验证 JSON 合法性（Node）
node -e "JSON.parse(require('fs').readFileSync('package.json','utf8')); console.log('package.json valid')"
git add package.json
git commit -m "fix(ci): remove merge conflict markers from package.json"
git push -u origin fix/package-json
# 创建 PR（网页或 gh）
gh pr create --title "fix: package.json conflict markers removed" --body "Fix invalid package.json which caused CI job failure" --base main --head fix/package-json
