# 在本地新建修复分支并替换 package.json（或编辑后验证）
git checkout -b fix/package-json

# 把“干净”的 package.json 写入（或者用编辑器粘贴）
cat > package.json <<'EOF'
{ 
  "name": "@bitkyc08/opencodex",
  "version": "2.8.0",
  "description": "Universal provider proxy for OpenAI Codex & Claude Code — use any LLM with Codex CLI/App/SDK and Claude Code",
  "type": "module",
  "main": "./bin/package-main.mjs",
  "exports": {
    ".": { "bun": "./src/index.ts","default": "./bin/package-main.mjs" },
    "./package.json": "./package.json"
  },
  "bin": { "opencodex":"./bin/ocx.mjs","ocx":"./bin/ocx.mjs" },
  "files": ["bin","src","gui/dist","assets/banner.png","assets/architecture.png","assets/claude-code-models.gif","assets/codex-app-picker.png","README.md","LICENSE"],
  "engines": { "node": ">=18" },
  "trustedDependencies": ["bun"],
  "scripts": { "dev":"bun run src/cli/index.ts start","test":"bun scripts/test.ts","typecheck":"bun x tsc --noEmit","build:gui":"cd gui && bun install --frozen-lockfile && bun run build && cd .. && bun run prepare:package", "prepare:package":"bun scripts/prepare-package.ts" },
  "dependencies": { "@bufbuild/protobuf":"^2.12.0","@modelcontextprotocol/sdk":"^1","bun":"1.3.14","zod":"4.4.3" },
  "devDependencies": { "@types/bun":"1.3.14","typescript":"5.9.3" },
  "overrides": { "fast-uri":"^3.1.4" },
  "repository": { "type":"git","url":"git+https://github.com/batuchek68-ux/opencodex.git" },
  "homepage":"https://lidge-jun.github.io/opencodex/","bugs":{ "url":"https://github.com/lidge-jun/opencodex/issues" },"license":"MIT"
}
EOF

# 验证
node -e "JSON.parse(require('fs').readFileSync('package.json','utf8')); console.log('OK')"

git add package.json
git commit -m "fix(ci): remove merge conflict markers from package.json"
git push -u origin fix/package-json

# 可选：在 GitHub 上把 fix/package-json 合并到你的 PR 分支，或直接创建一个新的 PR 将修复合并到 main
